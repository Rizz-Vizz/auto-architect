# Copy to .env for local development. On Zerops, set GROQ_API_KEY as a
# secret env variable on the "api" service instead (Environment variables ->
# Secret variables in the service detail) — never commit a real key.
#
# Get a free Groq API key (no credit card) at: https://console.groq.com

GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
PORT=8000
